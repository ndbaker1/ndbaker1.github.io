{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "types": [
      "vite/client",
      "$app/types"
    ],
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "#lib/*": ["src/lib/*"]
    }
  },
  "include": [
    "src",
    "test",
    "*"
  ],
  "exclude": [
    "src/service-worker"
  ]
}
